# このファイルをコピーして「.env」という名前で保存し、実際の値に書き換えてください。
#   cp .env.example .env
#
# .env は .gitignore に登録されているので、Gitにはコミットされません。
# (Client Secretのような機密情報を誤って公開しないための仕組みです)

# Twitch Developer Console (https://dev.twitch.tv/console) で
# 作成したアプリケーションの Client ID / Client Secret
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Twitch APIへ実際に問い合わせる最短間隔(秒)。
# 短くしすぎるとレート制限に引っかかる可能性があるため、30秒を推奨。
CACHE_TTL_SECONDS=30
